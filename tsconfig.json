{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "dom"],
    "sourceMap": true,

    //https://www.typescriptlang.org/tsconfig#jsx
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
